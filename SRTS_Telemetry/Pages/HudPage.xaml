<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SRTS_Telemetry.Pages.HudPage"
             xmlns:conv="clr-namespace:SRTS_Telemetry.Utils"
             Title="HUD">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BooleanInverterConverter x:Key="boolInverse"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Border>
        <Grid Background="Black" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- LEFT COLUMN -->
        <Border Grid.Row="0" Grid.Column="0">
            <StackLayout>
                <Label Text="{Binding RPM}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    Margin="0,0,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <BoxView x:Name="rpm1" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Green" Margin="2"/>
                        <BoxView x:Name="rpm2" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Green" Margin="2"/>
                        <BoxView x:Name="rpm3" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Yellow" Margin="2"/>
                        <BoxView x:Name="rpm4" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Yellow" Margin="2"/>
                        <BoxView x:Name="rpm5" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Orange" Margin="2"/>
                        <BoxView x:Name="rpm6" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Orange" Margin="2"/>
                        <BoxView x:Name="rpm7" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Red" Margin="2"/>
                        <BoxView x:Name="rpm8" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Red" Margin="2"/>
                        <BoxView x:Name="rpm9" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Purple" Margin="2"/>
                        <BoxView x:Name="rpm10" WidthRequest="20" HeightRequest="20" CornerRadius="50" BackgroundColor="Purple" Margin="2"/>
                    </StackLayout>
                <Label Text="RPM" TextColor="Magenta" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
            </StackLayout>
        </Border>
        <Border Grid.Row="1" Grid.Column="0">
            <StackLayout>
                <BoxView
                    x:Name="throttleBoxview"
                    Margin="0,0,0,0"
                    BackgroundColor="Green"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    HeightRequest="25"
                    WidthRequest="300"/>
                    <Label Text="{Binding Throttle}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                <Label Text="THROTTLE" TextColor="Magenta" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
            </StackLayout>
        </Border>
        <Border Grid.Row="2" Grid.Column="0">
            <StackLayout>
                <BoxView
                        x:Name="brakeBoxview"
                        Margin="0,0,0,0"
                        BackgroundColor="Red"
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                        HeightRequest="25"
                        WidthRequest="300"/>
                    <Label Text="{Binding Brake}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Title"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                <Label Text="BRAKE" TextColor="Magenta" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Title"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
            </StackLayout>
        </Border>
        
        <!-- CENTER COLUMN -->
        <Grid Grid.Row="0" Grid.Column="1">
            <StackLayout>
                <Border>
                    <StackLayout>
                        <Label Text="{Binding BestLap}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                            <Label Text="BEST LAP" TextColor="Magenta" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Default"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                </Border>
                <Border>
                    <StackLayout>
                        <Label Text="{Binding LastLap}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                        <Label Text="LAST LAP" TextColor="Magenta" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Default"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                </Border>
                </StackLayout>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <StackLayout>
                <StackLayout>
                    <Label Text="{Binding Speed}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    Margin="0,0,0,0"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="KM/H" TextColor="Cyan" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Title"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                </StackLayout>
            </StackLayout>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <StackLayout>
                <StackLayout>
                        <Label Text="{Binding Gear}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Title"
                        Margin="0,0,0,0"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                    <Label Text="GEAR" TextColor="Cyan" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Title"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                </StackLayout>
            </StackLayout>
        </Grid>
        
        <!-- RIGHT COLUMN -->
        <Border Grid.Row="0" Grid.Column="2">
            <StackLayout>
                    <Label Text="{Binding Position}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Medium"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                <Label Text="POSITION" TextColor="Yellow" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Medium"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding CurrentLap}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                        <Label Text="/" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                        <Label Text="{Binding TotalLaps}" TextColor="White" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <Label Text="LAPS" TextColor="Yellow" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                </StackLayout>
        </Border>
        <Border Grid.Row="1" Grid.Column="2">
            <StackLayout>
                <StackLayout Orientation="Horizontal" Margin="1">
                    <Label Text="FL: " TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="{Binding FrontLeftTyreTemp}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="ºC" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <StackLayout Orientation="Horizontal" Margin="1">
                    <Label Text="FR: " TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="{Binding FrontRightTyreTemp}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="ºC" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <StackLayout Orientation="Horizontal" Margin="1">
                    <Label Text="RL: " TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="{Binding RearLeftTyreTemp}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="ºC" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <StackLayout Orientation="Horizontal" Margin="1">
                    <Label Text="RR: " TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="{Binding RearRightTyreTemp}" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                    <Label Text="ºC" TextColor="White" 
                    FontAttributes="Bold" 
                    FontAutoScalingEnabled="True" 
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                    <Label Text="TYRE TEMP" TextColor="Yellow" 
                        FontAttributes="Bold" 
                        FontAutoScalingEnabled="True" 
                        FontSize="Medium"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"/>
                </StackLayout>
        </Border>
        <Border Grid.Row="2" Grid.Column="2">
                <StackLayout>
                    <StackLayout IsVisible="{Binding HasRevWarning}">
                        <BoxView
                         Margin="0,1,0,0"
                         WidthRequest="200"
                         HeightRequest="60"
                         BackgroundColor="Yellow"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>
            
                        <Label Text="REV WARNING" TextColor="White" 
                            FontAttributes="Bold" 
                            FontAutoScalingEnabled="True" 
                            FontSize="Title"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout IsVisible="{Binding HasRevWarning, Converter={StaticResource boolInverse}}">
                        <StackLayout Orientation="Horizontal" Margin="1">
                            <Label Text="Oil temp: " TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="{Binding OilTemp}" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="ºC" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Margin="1" IsVisible="Collapse">
                            <Label Text="Water temp: " TextColor="White" 
                            FontAttributes="Bold" 
                            FontAutoScalingEnabled="True" 
                            FontSize="Small"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"/>
                            <Label Text="{Binding WaterTemp}" TextColor="White" 
                            FontAttributes="Bold" 
                            FontAutoScalingEnabled="True" 
                            FontSize="Small"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"/>
                            <Label Text="ºC" TextColor="White" 
                            FontAttributes="Bold" 
                            FontAutoScalingEnabled="True" 
                            FontSize="Small"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Margin="1">
                            <Label Text="Oil pressure: " TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="{Binding OilPressure}" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="bar" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Margin="1">
                            <Label Text="Fuel level: " TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="{Binding CurrentFuel}" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                            <Label Text="%" TextColor="White" 
                                FontAttributes="Bold" 
                                FontAutoScalingEnabled="True" 
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                    </StackLayout>
                    <Label Text="STATUS" TextColor="Yellow" 
                            FontAttributes="Bold" 
                            FontAutoScalingEnabled="True" 
                            FontSize="Medium"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"/>
                </StackLayout>
            </Border>
    </Grid>
    </Border>
</ContentPage>