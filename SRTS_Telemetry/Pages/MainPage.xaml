<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SRTS_Telemetry.MainPage"
             xmlns:conv="clr-namespace:SRTS_Telemetry.Utils"
             Padding="0">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BooleanInverterConverter x:Key="boolInverse"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <StackLayout>
            <Frame Padding="15"
               CornerRadius="5"
               HasShadow="True"
               Margin="5"
               BorderColor="#E0E0E0">
                <StackLayout Orientation="Vertical">
                    <StackLayout>
                        <Label Text="Configurar conexão" FontSize="Subtitle" FontAttributes="Bold" Margin="5,0,0,10"/>
                        <StackLayout Orientation="Horizontal">
                            <Entry Placeholder="Porta local" WidthRequest="150" Keyboard="Numeric" HorizontalOptions="Start" Margin="5" Text="{Binding LocalPort}"/>
                            <Entry Placeholder="Porta remota" WidthRequest="150" Keyboard="Numeric" HorizontalOptions="Start" Margin="5" Text="{Binding RemotePort}"/>
                        </StackLayout>
                        <Entry Placeholder="Endereço IP" WidthRequest="310" HorizontalOptions="Start" Margin="5" Text="{Binding RemoteIPAddress}"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="Salvar sessão" FontSize="Subtitle" FontAttributes="Bold" Margin="5,0,0,10"/>
                        <CheckBox IsChecked="{Binding SaveSession}"/>
                    </StackLayout>
                    <Button Text="Conectar" Margin="5,35,0,0" Command="{Binding ConnectCommand}" HorizontalOptions="Start" IsEnabled="{Binding IsConnected, Converter={StaticResource boolInverse}}">
                        <Button.WidthRequest>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="Android" Value="310"/>
                                <On Platform="iOS" Value="310"/>
                                <On Platform="WinUI" Value="310"/>
                            </OnPlatform>
                        </Button.WidthRequest>
                        <Button.HeightRequest>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="Android" Value="50"/>
                                <On Platform="iOS" Value="50"/>
                                <On Platform="WinUI" Value="50"/>
                            </OnPlatform>
                        </Button.HeightRequest>
                    </Button>
                    <Button Text="Desconectar" Margin="5,35,0,0" Command="{Binding DisconnectCommand}" HorizontalOptions="Start" IsEnabled="{Binding IsConnected}">
                        <Button.WidthRequest>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="Android" Value="310"/>
                                <On Platform="iOS" Value="310"/>
                                <On Platform="WinUI" Value="310"/>
                            </OnPlatform>
                        </Button.WidthRequest>
                        <Button.HeightRequest>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="Android" Value="50"/>
                                <On Platform="iOS" Value="50"/>
                                <On Platform="WinUI" Value="50"/>
                            </OnPlatform>
                        </Button.HeightRequest>
                    </Button>
                </StackLayout>
            </Frame>
            <Frame Padding="15"
           CornerRadius="5"
           HasShadow="True"
           Margin="5"
           BorderColor="#E0E0E0">
                <StackLayout>
                    <Button Text="Limpar log" Command="{Binding ClearLogCommand}" WidthRequest="310"/>
                    <Label Text="Log" FontSize="Subtitle" FontAttributes="Bold" Margin="5,0,0,10"/>
                    <ScrollView>
                        <Editor IsReadOnly="True"
                        AutoSize="TextChanges"
                        FontSize="14"
                        Text="{Binding LogMessages}"/>
                    </ScrollView>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
